# Настройки игры. Скопируйте файл в .env и заполните нужное:
#   cp .env.example .env
# docker compose читает .env сам; в образы и в git он не попадает.
# Все строки необязательные: без них игра работает, просто с меньшим числом удобств.

# Пароль ведущего для /admin. Пусто — управлять игрой может любой, кто откроет
# /admin (годится только для доверенной сети).
ADMIN_PASSWORD=

# Токен Яндекс Музыки. Пусто — токен вставляется в настройках каждой игры.
# Как получить: раздел «Как получить токен Яндекс Музыки» в README.
YANDEX_TOKEN=

# Токен HuggingFace (read) с принятыми условиями pyannote/segmentation-3.0:
# https://huggingface.co/pyannote/segmentation-3.0
# Нужен только режиму согласия трёх моделей для треков без текста в Яндексе.
# Пусто — такие треки распознаёт WhisperX (классический режим «Яндекс + Whisper»).
HF_TOKEN=

# Треки без текста: on — согласие WhisperX и двух GigaAM (нужен HF_TOKEN),
# off — только WhisperX. Без HF_TOKEN режим on сам переходит на WhisperX.
CONSENSUS_MODE=on

# Через сколько секунд простоя модели GigaAM выгружаются из видеопамяти.
GIGAAM_IDLE_UNLOAD_SEC=60

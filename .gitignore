# ── Секреты ─────────────────────────────────────────────────────────────
# Токены HuggingFace и Яндекс Музыки, пароль ведущего. В репозитории — только
# шаблон .env.example без значений.
.env
.env.*
!.env.example
**/.env
*.pem
*.key
*.crt

# ── Музыка и всё, что из неё сделано ───────────────────────────────────
# Треки, клипы вопросов и тексты песен защищены авторским правом.
media/
temp_downloads/
*-temp_downloads/
*.mp3
*.wav
*.flac
*.m4a
*.ogg
*.opus
*.lrc
# Файлы игр: тексты вопросов (строки песен) и ответы.
*-questions.json
questions.json/
# Журнал выбора вопросов: в нём ответы.
logs/

# ── Кеши моделей (гигабайты, скачиваются заново) ───────────────────────
whisper_cache/
mdx_cache/
gigaam_cache/

# ── Исследовательская лаборатория ──────────────────────────────────────
# Не публикуется: корпус треков, тексты песен, прогоны моделей и отчёты.
asr_lab/

# ── Дневники разработки (остаются только локально) ─────────────────────
REPORT_*.md

# ── Python и инструменты ───────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/
*.egg-info/
.idea/
.vscode/
*.bak
*.bak-*
*.orig
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Local article materials, lab worktree and independent transcription project.
/article/
/asr_lab_wt/
/whisperx-large-v3-transcribe-server/
